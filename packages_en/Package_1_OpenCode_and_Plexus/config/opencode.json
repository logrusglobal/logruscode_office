{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "lgplexus": {
      "name": "Logrus Global Plexus",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "https://aiapi.plexus.logrusglobal.com/v1"
      },
      "models": {
        "deepseek-deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro (Plexus)",
          "variants": {
            "high": {
              "reasoningEffort": "high"
            },
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "deepseek-deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (Plexus)"
        }
      }
    }
  },
  "model": "lgplexus/deepseek-deepseek-v4-pro",
  "small_model": "lgplexus/deepseek-deepseek-v4-flash",
  "default_agent": "office",
  "agent": {
    "build": {
      "disable": true
    }
  }
}
